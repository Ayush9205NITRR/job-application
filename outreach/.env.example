# Copy to .env (gitignored). No quotes needed.
# Hosted Grist: GRIST_URL=https://docs.getgrist.com   Local Docker: http://localhost:8484
GRIST_URL=https://docs.getgrist.com
GRIST_API_KEY=
GRIST_DOC_ID=

# Link used for {{RESUME_LINK}} in emails (Drive / Notion / Papermark link to your CV)
RESUME_URL=

# Read-only Gmail without a browser (GitHub Actions). Leave blank on a laptop: credentials.json +
# token.json are used there instead. See the README for how to get a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
