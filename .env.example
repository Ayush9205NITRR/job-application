# Personal accounts only. Do NOT reuse Enout's Apollo or Airtable.
APIFY_TOKEN=
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
GEMINI_API_KEY=
APOLLO_API_KEY=
# Gmail OAuth (Desktop app client). token.json is created on first run.
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json

# Optional
GEMINI_MODEL=gemini-2.5-flash
APIFY_ACTOR=meka.im~linkedin-jobs-scraper
# First day you send from Gmail (YYYY-MM-DD). Drives the 5/day -> 20/day ramp.
# If unset, the earliest Touch "Drafted at" is used.
SEND_START_DATE=
RESUME_URL=
